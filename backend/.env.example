# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
# Production example (TLS + connect timeout):
# postgresql://user:password@host:5432/planex?sslmode=require&connect_timeout=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/planex?schema=public"

# Optional connection tuning (defaults shown)
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000
# Force TLS on/off when the URL has no sslmode (default: TLS for non-local DBs)
# DATABASE_SSL=true
# Verify the server certificate (default false; enable only with a trusted CA chain)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# JWT Secret for Authentication (must stay stable across deploys)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Redis (for BullMQ queues, caching, and rate-limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# AI Provider ("gemini" or "groq" - auto-detects if not specified)
AI_PROVIDER=gemini

# Google Gemini (Recommended - 1,000,000 Tokens/Min Free)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Groq AI LLM (Fallback / Alternative)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# OAuth Providers (Optional for local testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend.example.com/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-backend.example.com/auth/github/callback

# Supabase (Optional for avatar uploads)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
